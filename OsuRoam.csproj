<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OsuRoam</AssemblyName>
    <RootNamespace>OsuRoam</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>1.5.1.1</Version>
    <AssemblyVersion>1.5.1.1</AssemblyVersion>
    <FileVersion>1.5.1.1</FileVersion>
    <InformationalVersion>1.5.1+1</InformationalVersion>
    <ApplicationIcon>Assets\OsuRoam.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- 英文版：dotnet publish -p:RoamFlavor=en。同一份源码，只换常量与默认值，
       exe 仍然叫 OsuRoam.exe（改 AssemblyName 会让 XAML 里的 /OsuRoam;component/... 失效），
       两个版本各自打一个便携包、各占一个目录。 -->
  <PropertyGroup Condition="'$(RoamFlavor)' == 'en'">
    <DefineConstants>$(DefineConstants);EN_BUILD</DefineConstants>
    <AssemblyTitle>osu! Roam (English)</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <Page Remove="Tests\**\*.xaml" />
    <Resource Include="Assets\OsuRoam.ico" />
    <!-- 字体必须以 Resource 编进程序集，pack URI 才能按 #Outfit 找到它；
         Content/CopyToOutput 的话换目录运行就会掉字。 -->
    <Resource Include="Fonts\*.ttf" />
    <None Update="Fonts\ATTRIBUTION.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fonts\OFL-Outfit.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageReference Include="Wasmtime" Version="48.0.2" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\minacalc.wasm" />
    <EmbeddedResource Include="Resources\minacalc-75.wasm" />
  </ItemGroup>
</Project>
