<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OsuRoam</AssemblyName>
    <RootNamespace>OsuRoam</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>1.2.5+1</Version>
    <AssemblyVersion>1.2.5.0</AssemblyVersion>
    <FileVersion>1.2.5.0</FileVersion>
    <InformationalVersion>1.2.5</InformationalVersion>
    <ApplicationIcon>Assets\OsuRoam.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <Page Remove="Tests\**\*.xaml" />
    <Resource Include="Assets\OsuRoam.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageReference Include="Wasmtime" Version="48.0.2" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\minacalc.wasm" />
    <EmbeddedResource Include="Resources\minacalc-75.wasm" />
  </ItemGroup>
</Project>
