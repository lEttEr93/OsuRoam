<Project>
  <PropertyGroup>
    <AssemblyName>OsuRoam</AssemblyName>
    <IntermediateOutputPath>obj\Debug\</IntermediateOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>D:\AI\repos\osu-roam\obj\</MSBuildProjectExtensionsPath>
    <_TargetAssemblyProjectName>OsuRoam</_TargetAssemblyProjectName>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OsuRoam</AssemblyName>
    <RootNamespace>OsuRoam</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>1.5.2.2</Version>
    <AssemblyVersion>1.5.2.2</AssemblyVersion>
    <FileVersion>1.5.2.2</FileVersion>
    <InformationalVersion>1.5.2+2</InformationalVersion>
    <ApplicationIcon>Assets\OsuRoam.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- 英文版：dotnet publish -p:RoamFlavor=en。同一份源码，只换常量与默认值，
       exe 仍然叫 OsuRoam.exe（改 AssemblyName 会让 XAML 里的 /OsuRoam;component/... 失效），
       两个版本各自打一个便携包、各占一个目录。 -->
  <PropertyGroup Condition="'$(RoamFlavor)' == 'en'">
    <DefineConstants>$(DefineConstants);EN_BUILD</DefineConstants>
    <AssemblyTitle>osu! Roam (English)</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <!-- 字体必须以 Resource 编进程序集，pack URI 才能按 #Outfit 找到它；
         Content/CopyToOutput 的话换目录运行就会掉字。 -->
    <None Update="Fonts\ATTRIBUTION.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fonts\OFL-Outfit.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageReference Include="Wasmtime" Version="48.0.2" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\minacalc.wasm" />
    <EmbeddedResource Include="Resources\minacalc-75.wasm" />
    <!-- 审核过的 tag 白名单（Tools/build-tag-pool.py 生成）。发布时也会把 data/tag-pool.json 传到
         公开仓库的同一路径，app 启动时按 https://raw.githubusercontent.com/lEttEr93/OsuRoam/main/data/tag-pool.json 拉取；
         内嵌的这份是拿不到网络时的兜底，所以逻辑资源名保持不变。 -->
    <EmbeddedResource Include="data\tag-pool.json" LogicalName="OsuRoam.Resources.tag-pool.json" />
    <!-- 待审 tag 的提交凭据（细粒度 PAT，只给该仓库 issues:write）。
         这个文件在 .gitignore 里，不进仓库；没有它时自动提交功能关闭，其它功能不受影响。 -->
    <EmbeddedResource Include="data\tag-submit-token.txt" LogicalName="OsuRoam.Resources.tag-submit-token.txt" Condition="Exists('data\tag-submit-token.txt')" />
  </ItemGroup>
