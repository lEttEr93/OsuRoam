<Window x:Class="OsuRoam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OsuRoam.Controls"
        Title="osu! Roam" Width="430" Height="720" MinWidth="390" MinHeight="300"
        FontFamily="{DynamicResource UiFont}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="CanResizeWithGrip" ShowInTaskbar="True" Icon="/OsuRoam;component/Assets/OsuRoam.ico">
    <Border Margin="8" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="7">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource SurfaceBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 迷你播放器曲绘背景：只在折叠态显示（和 MiniPlayerHeader 一起显隐）。
                     这条只有 64px 高，整幅曲绘是"按高度对齐"填满，因此用重糊的 BackdropFill；
                     左右空出来的部分交给铺满整条的模糊底。 -->
                <Grid x:Name="MiniBackdrop" Grid.ColumnSpan="2" Visibility="Collapsed" IsHitTestVisible="False"
                      DataContext="{Binding ElementName=MiniPlayerHeader, Path=DataContext}">
                    <Border CornerRadius="7,7,0,0" Opacity="0.30"
                            RenderOptions.BitmapScalingMode="HighQuality">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding BackdropFill}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <Border CornerRadius="7,7,0,0" Opacity="0.50"
                            RenderOptions.BitmapScalingMode="HighQuality">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding BackdropBar}" Stretch="Uniform"
                                        AlignmentX="Center" AlignmentY="Center" />
                        </Border.Background>
                    </Border>
                    <Border CornerRadius="7,7,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#5A121416" Offset="0" />
                                <GradientStop Color="#8E121416" Offset="0.55" />
                                <GradientStop Color="#B4121416" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>

                <StackPanel x:Name="NormalHeader" Margin="14,0" VerticalAlignment="Center">
                    <TextBlock Text="osu! Roam" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="ConnectionText" Text="{DynamicResource L.conn.idle}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                </StackPanel>
                <Grid x:Name="MiniPlayerHeader" Visibility="Collapsed" Margin="14,0,4,0" VerticalAlignment="Center">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="MiniHeaderScale" />
                            <TranslateTransform x:Name="MiniHeaderSlide" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="58" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,7,0" VerticalAlignment="Center">
                        <TextBlock x:Name="MiniTitleText"
                                   FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="MiniTrackDetailText" Text="{DynamicResource L.mini.waiting}"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="10" TextTrimming="CharacterEllipsis">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="MiniDetailSlide" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </StackPanel>
                    <Button x:Name="MiniInfoButton" Grid.Column="1" Width="30" Height="30" Padding="0" Margin="0,0,6,0"
                            Content="i" FontWeight="SemiBold" Click="MiniInfoButton_Click"
                            ToolTip="{DynamicResource L.tip.showinfo}" />
                    <Button x:Name="MiniNextButton" Grid.Column="2" Width="58" Height="30" Padding="0"
                            Content="{DynamicResource L.btn.next}" Click="MiniNextButton_Click" ToolTip="{DynamicResource L.tip.next}" />
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,7,7,7">
                    <Button x:Name="HistoryButton" Content="{DynamicResource L.btn.history}" MinWidth="46" Padding="8,0" Margin="0,0,6,0"
                            Click="HistoryButton_Click" ToolTip="{DynamicResource L.tip.history}" />
                    <Button x:Name="CollapseButton" Content="−" Width="34" Padding="0" Click="CollapseButton_Click" ToolTip="{DynamicResource L.tip.miniplayer}" />
                    <Button x:Name="CloseButton" Width="34" Margin="6,0,0,0" Padding="0"
                            PreviewMouseLeftButtonDown="CloseButton_HoldStart"
                            PreviewMouseLeftButtonUp="CloseButton_HoldEnd"
                            MouseLeave="CloseButton_HoldCancel"
                            ToolTip="{DynamicResource L.tip.closehold}">
                        <Grid>
                            <!-- 长按 650ms 才真的退出：进度环填满即触发，松手就弹回 -->
                            <controls:ProgressRing x:Name="CloseHoldRing" Width="26" Height="26" StrokeThickness="2.5"
                                                   TrackBrush="Transparent" ProgressBrush="{StaticResource AccentBrush}"
                                                   IsHitTestVisible="False" />
                            <TextBlock Text="×" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="MainContent" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          controls:SmoothScroll.IsEnabled="True">
                <StackPanel Margin="14,12,14,16">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource L.section.next}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="ProfileText" Text="{DynamicResource L.profile.waiting}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                        </StackPanel>
                        <Button x:Name="StartButton" Grid.Column="1" Content="{DynamicResource L.btn.start}" Background="{StaticResource AccentBrush}"
                                BorderBrush="{StaticResource AccentBrush}" Click="StartButton_Click" />
                    </Grid>

                    <ItemsControl x:Name="RecommendationList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" ClipToBounds="True"
                                        Loaded="RecommendationCard_Loaded">
                                    <Grid>
                                        <!-- 2. 铺满整卡的模糊副本（用重糊的 BackdropFill，否则底部会透出空档） -->
                                        <Border CornerRadius="6" Opacity="0.18" IsHitTestVisible="False"
                                                RenderOptions.BitmapScalingMode="HighQuality">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding BackdropFill}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>

                                        <!-- 3. 顶部整幅曲绘：alpha 渐隐已烘在位图里，下边缘天然透明 -->
                                        <Border CornerRadius="6" Opacity="0.6" IsHitTestVisible="False"
                                                RenderOptions.BitmapScalingMode="HighQuality">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Backdrop}" Stretch="Uniform"
                                                            AlignmentX="Center" AlignmentY="Top" />
                                            </Border.Background>
                                        </Border>

                                        <!-- 4. 压暗：不再到全不透明，否则下半部分会被压成死黑 -->
                                        <Border IsHitTestVisible="False">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#70121416" Offset="0" />
                                                    <GradientStop Color="#AE121416" Offset="0.32" />
                                                    <GradientStop Color="#CC121416" Offset="0.68" />
                                                    <GradientStop Color="#DC121416" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <Grid Margin="9">
                                        <Grid Visibility="{Binding IsSummaryVisible, Converter={StaticResource BoolToVis}}">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <!-- 翻回摘要层：淡入 -->
                                                        <DataTrigger Binding="{Binding IsSummaryVisible}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         From="0" To="1" Duration="0:0:0.18">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="42" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="40" Height="40" VerticalAlignment="Top" Margin="0,1,0,0">
                                            <Button x:Name="PreviewButton" Width="40" Height="40" Padding="0"
                                                    Tag="{Binding}"
                                                    Click="PreviewButton_Click" ToolTip="{DynamicResource L.tip.preview}"
                                                    Background="#33FFFFFF" BorderBrush="#55FFFFFF">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Opacity" Value="0.55" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPreviewLoading}" Value="True">
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Opacity" Value="1" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Grid>
                                                    <controls:ProgressRing Width="26" Height="26" StrokeThickness="2.5"
                                                                           Progress="{Binding PreviewProgress}"
                                                                           TrackBrush="#66778088"
                                                                           ProgressBrush="{StaticResource AccentBrush}"
                                                                           IsHitTestVisible="False">
                                                        <controls:ProgressRing.Style>
                                                            <Style TargetType="{x:Type controls:ProgressRing}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPreviewLoading}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </controls:ProgressRing.Style>
                                                    </controls:ProgressRing>
                                                    <TextBlock Text="{Binding PreviewButtonContent}" FontSize="14"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Grid.Row="0" Margin="6,0,8,0">
                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DifficultyName}" Foreground="{StaticResource SecondaryBrush}"
                                                       FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DifficultySummary}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                            <TextBlock FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Mapper}" /><Run Text=" · " /><Run Text="{Binding RankedYear}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Reason}" FontSize="11" Foreground="{StaticResource WarningBrush}" />
                                            <Grid Margin="0,4,0,0">
                                                <!-- 进度条和状态文字分两列：叠在一起时中文「等待」还行，
                                                     英文 Waiting/Downloading 会盖在条上还被右边裁掉。 -->
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Height="3" VerticalAlignment="Center"
                                                             Minimum="0" Maximum="1" Value="{Binding DownloadProgress}" />
                                                <TextBlock Grid.Column="1" Text="{Binding DownloadLabel}" Margin="6,0,0,0"
                                                           VerticalAlignment="Center" FontSize="10"
                                                           Foreground="{StaticResource MutedTextBrush}" />
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Grid.Row="0">
                                            <Button Content="↓" Height="29" Padding="0" Tag="{Binding}" Click="DownloadButton_Click" ToolTip="{DynamicResource L.tip.download}" />
                                            <Button Content="↷" Height="29" Margin="0,6,0,0" Padding="0" Tag="{Binding}" Click="SkipButton_Click" ToolTip="{DynamicResource L.tip.skip}" />
                                            <Button Content="..." Height="29" Margin="0,6,0,0" Padding="0" Tag="{Binding}" Click="DetailButton_Click" ToolTip="{DynamicResource L.tip.detail}" />
                                        </StackPanel>
                                        <Expander Grid.Row="1" Grid.ColumnSpan="3" Header="Tags" Margin="54,7,42,0">
                                            <ItemsControl ItemsSource="{Binding TagItems}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding Name}" Tag="{Binding Name}" Padding="7,3" Margin="0,0,5,5"
                                                                MouseDoubleClick="RecommendationTag_MouseDoubleClick" ToolTip="{DynamicResource L.tip.taginclude}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsIncluded}" Value="True">
                                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                                            <Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                        </Grid>
                                        <Grid Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVis}}">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <!-- 翻到详情层：淡入 -->
                                                        <DataTrigger Binding="{Binding IsDetailVisible}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         From="0" To="1" Duration="0:0:0.20">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <!-- 只留 7 轴技能雷达：核心键型占比加起来是 1，用条看更准 -->
                                                <controls:RadarChart Width="132" Height="132" HorizontalAlignment="Center"
                                                                     LabelFontFamily="{DynamicResource UiFont}"
                                                                     Labels="{Binding RadarLabels}" Values="{Binding RadarValues}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding DetailTitle}" FontWeight="SemiBold" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" />
                                                <ItemsControl ItemsSource="{Binding DetailLines}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" FontSize="11" Margin="0,2,0,0"
                                                                       Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <controls:PatternBars Margin="0,6,0,0"
                                                                      Labels="{Binding PatternBarLabels}"
                                                                      Shares="{Binding PatternBars}" />
                                                <Button Content="{DynamicResource L.btn.back}" Tag="{Binding}" Click="DetailButton_Click"
                                                        HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,2" FontSize="10" />
                                            </StackPanel>
                                        </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="EmptyPoolText" Text="{DynamicResource L.empty.pool}" Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Center" Margin="0,18" />

                    <Expander x:Name="RangeExpander" Header="{DynamicResource L.section.range}" IsExpanded="True" Margin="0,8,0,0">
                        <Grid Margin="0,10,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button x:Name="SuggestDifficultyButton" Grid.ColumnSpan="2" Content="{DynamicResource L.btn.suggest}" HorizontalAlignment="Left" Padding="10,4" Margin="0,0,0,9" Click="SuggestDifficultyButton_Click" />
                            <TextBlock x:Name="DifficultyProfileText" Grid.Column="2" HorizontalAlignment="Right"
                                       Foreground="{StaticResource SecondaryBrush}" FontSize="11" />
                            <StackPanel Grid.Row="1" Visibility="Collapsed">
                                <TextBlock Text="{DynamicResource L.label.minstar}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Visibility="Collapsed">
                                <TextBlock Text="{DynamicResource L.label.maxstar}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            </StackPanel>
                            <Grid Grid.Row="1" Grid.ColumnSpan="3">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="42" /></Grid.RowDefinitions>
                                <TextBlock Text="{DynamicResource L.label.stars}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <Grid x:Name="StarRangeControl" Grid.Row="1" Height="42" SizeChanged="StarRangeControl_SizeChanged">
                                    <Canvas x:Name="StarRangeCanvas" Background="Transparent" MouseLeftButtonDown="StarRangeTrack_MouseLeftButtonDown" MouseMove="StarRangeCanvas_MouseMove" MouseLeftButtonUp="StarRangeCanvas_MouseLeftButtonUp">
                                        <Border x:Name="StarRangeTrack" Canvas.Top="15" Height="12" BorderBrush="#3F4951" BorderThickness="1" CornerRadius="4">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                    <GradientStop Color="#3D96F5" Offset="0" />
                                                    <GradientStop Color="#43C2CE" Offset="0.20" />
                                                    <GradientStop Color="#71D26F" Offset="0.38" />
                                                    <GradientStop Color="#E0C352" Offset="0.55" />
                                                    <GradientStop Color="#DE6676" Offset="0.72" />
                                                    <GradientStop Color="#B364C5" Offset="0.88" />
                                                    <GradientStop Color="#6A84D4" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border x:Name="StarRangeLeftDim" Canvas.Top="15" Height="12" Background="#42000000" CornerRadius="4,0,0,4" IsHitTestVisible="False" />
                                        <Border x:Name="StarRangeRightDim" Canvas.Top="15" Height="12" Background="#42000000" CornerRadius="0,4,4,0" IsHitTestVisible="False" />
                                        <Border x:Name="MinimumStarThumb" Canvas.Top="9" Width="30" Height="24" Background="#3D96F5" BorderBrush="#74C5FF" BorderThickness="1" CornerRadius="3" Cursor="Hand" MouseLeftButtonDown="MinimumStarThumb_MouseLeftButtonDown"><TextBlock x:Name="MinimumStarText" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="#0C1A2A" /></Border>
                                        <Border x:Name="MaximumStarThumb" Canvas.Top="9" Width="30" Height="24" Background="#20262C" BorderBrush="#56636E" BorderThickness="1" CornerRadius="3" Cursor="Hand" MouseLeftButtonDown="MaximumStarThumb_MouseLeftButtonDown"><TextBlock x:Name="MaximumStarText" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" /></Border>
                                    </Canvas>
                                </Grid>
                            </Grid>
                            <StackPanel Grid.Row="2" Margin="0,9,0,0">
                                <TextBlock Text="{DynamicResource L.label.minyear}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <TextBox x:Name="MinimumYearBox" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,9,0,0">
                                <TextBlock Text="{DynamicResource L.label.maxyear}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <TextBox x:Name="MaximumYearBox" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Margin="0,9,0,0">
                                <TextBlock Text="{DynamicResource L.label.minlength}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <TextBox x:Name="MinimumLengthBox" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,9,0,0">
                                <TextBlock Text="{DynamicResource L.label.maxlength}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <TextBox x:Name="MaximumLengthBox" />
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource L.label.simplefilter}" Foreground="{StaticResource SecondaryBrush}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                               Text="{DynamicResource L.hint.simplefilter}"
                                               Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="8,0,0,0" />
                                </Grid>
                                <TextBlock Text="{DynamicResource L.label.status}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,7,0,1" />
                                <ItemsControl x:Name="StatusFilterItems">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding DisplayName}" IsThreeState="True" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      Tag="{Binding Value}" Click="StatusFilterCheckBox_Click" Margin="0,0,12,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{DynamicResource L.label.genre}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,1" />
                                <ItemsControl x:Name="GenreFilterItems">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding DisplayName}" IsThreeState="True" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      Tag="{Binding Value}" Click="GenreFilterCheckBox_Click" Margin="0,0,12,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{DynamicResource L.label.language}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,1" />
                                <ItemsControl x:Name="LanguageFilterItems">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding DisplayName}" IsThreeState="True" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      Tag="{Binding Value}" Click="LanguageFilterCheckBox_Click" Margin="0,0,12,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Tags" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <TextBox x:Name="TagSearchBox" Margin="0,3,0,4" TextChanged="TagSearchBox_TextChanged" />
                                <ListBox x:Name="TagListBox" Height="90" SelectionMode="Extended" DisplayMemberPath="." Background="{StaticResource SurfaceRaisedBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" />
                                <WrapPanel Margin="0,4,0,0">
                                    <Button Content="{DynamicResource L.btn.include}" Click="IncludeTagsButton_Click" Margin="0,0,6,0" />
                                    <Button Content="{DynamicResource L.btn.exclude}" Click="ExcludeTagsButton_Click" />
                                </WrapPanel>
                                <TextBlock Text="{DynamicResource L.label.includedtags}" Margin="0,5,0,2" FontSize="11" Foreground="{StaticResource SecondaryBrush}" />
                                <ItemsControl x:Name="IncludedTagsItems">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" Tag="{Binding}" Click="RemoveIncludedTagButton_Click" Margin="0,0,4,3" Padding="7,2" /></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{DynamicResource L.label.excludedtags}" Margin="0,3,0,2" FontSize="11" Foreground="{StaticResource WarningBrush}" />
                                <ItemsControl x:Name="ExcludedTagsItems">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" Tag="{Binding}" Click="RemoveExcludedTagButton_Click" Margin="0,0,4,3" Padding="7,2" /></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Margin="0,10,0,0">
                                <DockPanel>
                                    <TextBlock Text="{DynamicResource L.label.exploration}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    <TextBlock x:Name="ExplorationText" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="11" />
                                </DockPanel>
                                <Slider x:Name="ExplorationSlider" Minimum="0" Maximum="1" TickFrequency="0.05"
                                        ValueChanged="ExplorationSlider_ValueChanged" />
                            </StackPanel>
                        </Grid>
                    </Expander>

                    <Expander x:Name="AccountExpander" Header="{DynamicResource L.section.account}" Margin="0,8,0,0">
                        <StackPanel Margin="0,10,0,4">
                            <TextBlock Text="{DynamicResource L.label.username}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            <TextBox x:Name="UsernameBox" />
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="OAuth Client ID" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    <TextBox x:Name="ClientIdBox" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource L.label.mode}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    <ComboBox x:Name="ModeBox" SelectedIndex="0" SelectionChanged="ModeBox_SelectionChanged"
                                              DropDownOpened="ComboBox_DropDownOpened" DropDownClosed="ComboBox_DropDownClosed">
                                        <ComboBoxItem Content="osu!standard" Tag="osu" />
                                        <ComboBoxItem Content="taiko" Tag="taiko" />
                                        <ComboBoxItem Content="catch" Tag="fruits" />
                                        <ComboBoxItem Content="mania" Tag="mania" />
                                    </ComboBox>
                                    <StackPanel x:Name="ManiaKeysPanel" Visibility="Collapsed" Margin="0,7,0,0">
                                        <TextBlock Text="{DynamicResource L.label.keys}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                        <ComboBox x:Name="ManiaKeysBox" SelectedIndex="3" SelectionChanged="ManiaKeysBox_SelectionChanged"
                                                  DropDownOpened="ComboBox_DropDownOpened" DropDownClosed="ComboBox_DropDownClosed">
                                            <ComboBoxItem Content="1K" Tag="1" /><ComboBoxItem Content="2K" Tag="2" />
                                            <ComboBoxItem Content="3K" Tag="3" /><ComboBoxItem Content="4K" Tag="4" />
                                            <ComboBoxItem Content="5K" Tag="5" /><ComboBoxItem Content="6K" Tag="6" />
                                            <ComboBoxItem Content="7K" Tag="7" /><ComboBoxItem Content="8K" Tag="8" />
                                            <ComboBoxItem Content="9K" Tag="9" /><ComboBoxItem Content="10K" Tag="10" />
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="OAuth Client Secret" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,9,0,0" />
                            <PasswordBox x:Name="ClientSecretBox" />
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="InterfaceExpander" Header="{DynamicResource L.section.interface}" Margin="0,8,0,0">
                        <StackPanel Margin="0,10,0,4">
                            <TextBlock Text="{DynamicResource L.label.uilanguage}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            <ComboBox x:Name="LanguageBox" SelectedIndex="0" SelectionChanged="LanguageBox_SelectionChanged"
                                      DropDownOpened="ComboBox_DropDownOpened" DropDownClosed="ComboBox_DropDownClosed">
                                <ComboBoxItem Content="{DynamicResource L.lang.auto}" Tag="auto" />
                                <ComboBoxItem Content="{DynamicResource L.lang.zh}" Tag="zh" />
                                <ComboBoxItem Content="{DynamicResource L.lang.en}" Tag="en" />
                            </ComboBox>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="AdvancedExpander" Header="{DynamicResource L.section.advanced}" Margin="0,8,0,0">
                        <StackPanel Margin="0,10,0,4">
                            <WrapPanel Margin="0,0,0,9">
                                <CheckBox x:Name="ExcludeRecentCheck" Content="{DynamicResource L.check.excluderecent}" Margin="0,0,18,0" />
                                <CheckBox x:Name="ExcludeInstalledCheck" Content="{DynamicResource L.check.excludeinstalled}"
                                          ToolTip="{DynamicResource L.tip.excludeinstalled}" Click="ExcludeInstalledCheck_Click" />
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,9">
                                <CheckBox x:Name="AutoDownloadCheck" Content="{DynamicResource L.check.autodownload}" Margin="0,0,18,0" />
                                <CheckBox x:Name="AutoImportCheck" Content="{DynamicResource L.check.autoimport}" />
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,9">
                                <CheckBox x:Name="EmbeddedFontCheck" Content="{DynamicResource L.check.embeddedfont}" Click="EmbeddedFontCheck_Click"
                                          ToolTip="{DynamicResource L.tip.embeddedfont}" />
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,9">
                                <CheckBox x:Name="MapInfoCheck" Content="{DynamicResource L.check.mapinfo}" Click="MapInfoCheck_Click"
                                          ToolTip="{DynamicResource L.tip.mapinfo}" />
                            </WrapPanel>
                            <StackPanel Margin="0,0,0,9">
                                <TextBlock Text="{DynamicResource L.label.infosource}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <ComboBox x:Name="MapInfoSourceBox" SelectedIndex="0"
                                          SelectionChanged="MapInfoSourceBox_SelectionChanged"
                                          DropDownOpened="ComboBox_DropDownOpened" DropDownClosed="ComboBox_DropDownClosed">
                                    <ComboBoxItem Content="{DynamicResource L.infosource.import}" Tag="import" />
                                    <ComboBoxItem Content="{DynamicResource L.infosource.ingame}" Tag="ingame" />
                                </ComboBox>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource L.label.client}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            <ComboBox x:Name="OsuClientBox" SelectedIndex="0"
                                      DropDownOpened="ComboBox_DropDownOpened" DropDownClosed="ComboBox_DropDownClosed">
                                <ComboBoxItem Content="osu!lazer" Tag="lazer" />
                                <ComboBoxItem Content="osu!stable" Tag="stable" />
                            </ComboBox>
                            <TextBlock Text="{DynamicResource L.label.poolsize}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            <ComboBox x:Name="PoolSizeBox" SelectedIndex="2"
                                      DropDownOpened="ComboBox_DropDownOpened" DropDownClosed="ComboBox_DropDownClosed">
                                <ComboBoxItem Content="3" /><ComboBoxItem Content="4" /><ComboBoxItem Content="5" />
                                <ComboBoxItem Content="6" /><ComboBoxItem Content="8" /><ComboBoxItem Content="10" />
                            </ComboBox>
                            <TextBlock Text="{DynamicResource L.label.cachelimit}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,9,0,0" />
                            <TextBox x:Name="CacheLimitBox" />
                            <TextBlock Text="{DynamicResource L.label.osupath}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,9,0,0" />
                            <TextBox x:Name="OsuPathBox" />
                            <TextBlock Text="{DynamicResource L.label.mirrors}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,9,0,0" />
                            <TextBox x:Name="DownloadTemplateBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" VerticalScrollBarVisibility="Auto" />
                            <TextBlock Text="tosu WebSocket" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,9,0,0" />
                            <TextBox x:Name="TosuUrlBox" />
                            <WrapPanel Margin="0,9,0,0">
                                <CheckBox x:Name="AutoStartTosuCheck" Content="{DynamicResource L.check.autotosu}" Margin="0,0,18,0" />
                                <CheckBox x:Name="StopManagedTosuCheck" Content="{DynamicResource L.check.stoptosu}" />
                            </WrapPanel>
                            <TextBlock Text="{DynamicResource L.label.tosupath}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,9,0,0" />
                            <TextBox x:Name="TosuPathBox" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="Footer" Grid.Row="2" Background="{StaticResource SurfaceBrush}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="StatusText" Text="{DynamicResource L.status.ready}" Margin="14,6,8,6" VerticalContentAlignment="Center"
                         IsReadOnly="True" IsTabStop="True" TextWrapping="Wrap" AcceptsReturn="True"
                         BorderThickness="0" Background="Transparent" ToolTip="{DynamicResource L.tip.status}" />
                <Button Grid.Column="1" Content="{DynamicResource L.btn.copy}" Margin="0,6,6,6" Padding="10,0" Click="CopyStatusButton_Click" />
                <Button Grid.Column="2" Content="{DynamicResource L.btn.refresh}" Margin="0,6,8,6" Padding="12,0" Click="RefreshButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
