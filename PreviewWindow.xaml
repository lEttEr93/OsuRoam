<Window x:Class="OsuRoam.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OsuRoam.Controls"
        Title="{DynamicResource L.preview.title}" Width="390" Height="420" SizeToContent="Manual"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        FontFamily="{DynamicResource UiFont}">
    <Border x:Name="RootCard" Margin="8" Background="#121416" BorderBrush="#34393E"
            BorderThickness="1" CornerRadius="7" Opacity="0">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="CardScale" />
                <TranslateTransform x:Name="CardSlide" />
            </TransformGroup>
        </Border.RenderTransform>

        <Grid>
            <Border CornerRadius="7" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#17212A" Offset="0" />
                        <GradientStop Color="#121416" Offset="0.4" />
                        <GradientStop Color="#121416" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid Margin="11,9,11,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 头部：曲名 + 键数/谱师 + 关闭 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TrackTitle" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TrackMeta" FontSize="10" Margin="0,1,0,0"
                                   Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button x:Name="CloseButton" Grid.Column="1" Content="×" Width="26" Height="26" Padding="0"
                            VerticalAlignment="Top" Click="CloseButton_Click"
                            ToolTip="{DynamicResource L.mapinfo.close}" />
                </Grid>

                <!-- 轨道区：横向铺满、纵向吃满卡片剩下的高度 -->
                <Border Grid.Row="1" Margin="0,7,0,0" Background="#0A0D10" BorderBrush="#1E252B"
                        BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                    <Grid>
                        <controls:PreviewSurface x:Name="Field" IsHitTestVisible="False" />
                        <Border x:Name="MessagePanel" Padding="10,7" CornerRadius="5" Visibility="Collapsed"
                                Background="#CC0A0D10" BorderBrush="#2A3238" BorderThickness="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="260">
                            <TextBlock x:Name="MessageText" FontSize="10" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- 底部：预览音频的绝对位置 + 在整张谱里的位置 -->
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock x:Name="ClockText" FontSize="10" Foreground="{StaticResource SecondaryBrush}" />
                        <TextBlock x:Name="SpanText" FontSize="10" HorizontalAlignment="Right"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </Grid>

                    <!-- 进度条用 RenderTransform 缩放，不改进度条宽度：改宽度会触发布局，
                         每 200ms 一次布局正好是帧时间 p95 的那几个尖峰。 -->
                    <Border Grid.Row="1" Height="3" Margin="0,4,0,0" CornerRadius="2"
                            Background="#22262A" ClipToBounds="True">
                        <Border x:Name="ProgressFill" Background="#3FAFA6" CornerRadius="2"
                                RenderTransformOrigin="0,0.5" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
