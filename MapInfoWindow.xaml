<Window x:Class="OsuRoam.MapInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OsuRoam.Controls"
        Title="{DynamicResource L.mapinfo.title}" Width="390" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        FontFamily="{DynamicResource UiFont}">
    <Window.Resources>
        <!-- 键型占比条的填充色，取自 MMA 的 .cluster-fill 渐变 -->
        <LinearGradientBrush x:Key="BarFillBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4EC7FF" Offset="0" />
            <GradientStop Color="#58F0D9" Offset="0.6" />
            <GradientStop Color="#F6EF6B" Offset="1" />
        </LinearGradientBrush>
    </Window.Resources>

    <Border x:Name="RootCard" Margin="8" Background="#121416" BorderBrush="#34393E"
            BorderThickness="1" CornerRadius="7" Opacity="0">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="CardScale" />
                <TranslateTransform x:Name="CardSlide" />
            </TransformGroup>
        </Border.RenderTransform>

        <Grid>
            <!-- 曲绘背景：铺满整块的模糊底 + 顶部整幅（下边缘已烘好 alpha 渐隐）+ 压暗 -->
            <Border CornerRadius="7" Opacity="0.20" IsHitTestVisible="False"
                    RenderOptions.BitmapScalingMode="HighQuality">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding BackdropFill}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
            <Border CornerRadius="7" Opacity="0.55" IsHitTestVisible="False"
                    RenderOptions.BitmapScalingMode="HighQuality">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Backdrop}" Stretch="Uniform"
                                AlignmentX="Center" AlignmentY="Top" />
                </Border.Background>
            </Border>
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#6A121416" Offset="0" />
                        <GradientStop Color="#A4121416" Offset="0.35" />
                        <GradientStop Color="#C8121416" Offset="0.72" />
                        <GradientStop Color="#DC121416" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid Margin="11,9,11,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- 星级/胶囊那一行用星号：卡片高度锁定时，剩余空间都给它，
                     提示态的文字才能垂直居中；正常态 SizeToContent 下等价于 Auto -->
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 头部：封面 + 曲名 + 难度 + 谱师 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TrackTitle" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TrackDifficulty" FontSize="11" Foreground="{StaticResource SecondaryBrush}"
                               Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TrackMeta" FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button x:Name="CloseButton" Grid.Column="1" Content="×" Width="26" Height="26" Padding="0"
                        VerticalAlignment="Top" Click="CloseButton_Click"
                        ToolTip="{DynamicResource L.mapinfo.close}" />
            </Grid>

            <!-- 星级 + 数据胶囊 -->
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" x:Name="StarPanel">
                    <TextBlock x:Name="StarValue" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock x:Name="StarGlyph" Text="★" FontSize="10" Margin="3,0,0,3" VerticalAlignment="Bottom" />
                </StackPanel>

                <WrapPanel x:Name="CapsulePanel" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" />
            </Grid>

            <!-- RC / LN 占比横条：LN 过面谱门槛时右侧变粉 -->
            <Grid x:Name="RatioRow" Grid.Row="2" Margin="0,9,0,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock x:Name="RcRatioLabel" FontSize="9" Foreground="{StaticResource SecondaryBrush}" />
                    <TextBlock x:Name="LnRatioLabel" FontSize="9" HorizontalAlignment="Right"
                               Foreground="{StaticResource MutedTextBrush}" />
                </Grid>

                <Border Grid.Row="1" Height="6" Margin="0,3,0,0" CornerRadius="3"
                        Background="#22262A" ClipToBounds="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="RcRatioColumn" />
                            <ColumnDefinition x:Name="LnRatioColumn" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="3,0,0,3">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#2E8FC0" Offset="0" />
                                    <GradientStop Color="#3FAFA6" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="LnRatioBar" Grid.Column="1" CornerRadius="0,3,3,0" Background="#FF5C8A" />
                    </Grid>
                </Border>
            </Grid>

            <!-- tosu 读不到 osu! 时的提示：跨所有行、垂直居中，提示态和谱面态同高 -->
            <StackPanel x:Name="NoticePanel" Grid.Row="1" VerticalAlignment="Center"
                        Margin="0,6,0,0" Visibility="Collapsed">
                <TextBlock x:Name="NoticeReason" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource WarningBrush}" />
                <TextBlock x:Name="NoticeHint" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>

            <!-- 雷达 + 键型占比 -->
            <Grid x:Name="PatternRow" Grid.Row="3" Margin="0,9,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="RadarPanel" Width="152">
                    <!-- 只保留 7 轴技能雷达；6 个核心键型占比和上面不是一类数据，用直方图 -->
                    <controls:RadarChart x:Name="Radar" Width="152" Height="152" HorizontalAlignment="Center"
                                         LabelFontFamily="{DynamicResource UiFont}" />
                </StackPanel>

                <!-- 右列：SV 四个小环（等时性 / 舒适度 / 背谱 / 强度）压在键型占比上面 -->
                <StackPanel x:Name="PatternSidePanel" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <controls:SvRings x:Name="SvRingRow" Margin="0,0,0,8" Visibility="Collapsed" />
                    <controls:PatternBars x:Name="Bars" />
                </StackPanel>

                <!-- 键型还在后台算：撑住和雷达一样的高度，数据到达时卡片不会跳一下 -->
                <Border x:Name="PatternPlaceholder" Grid.ColumnSpan="2" Height="152" Visibility="Collapsed"
                        Background="#101417" BorderBrush="#232A30" BorderThickness="1" CornerRadius="6">
                    <TextBlock Text="{DynamicResource L.mapinfo.analyzing}" FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>

            <Border x:Name="Separator" Grid.Row="4" Height="1" Background="#242A30" Margin="0,10,0,8" />

            <TextBlock x:Name="DetailText" Grid.Row="5" Margin="0,0,170,0" FontSize="10"
                       TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />

            <TextBlock x:Name="ReasonText" Grid.Row="6" Margin="0,5,0,0" FontSize="10"
                       TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" />
            </Grid>
        </Grid>
    </Border>
</Window>
