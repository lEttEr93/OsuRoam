<Window x:Class="OsuRoam.Controls.PoolsDebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="池子调试"
        Width="960" Height="640"
        MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#0F1116"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#171A21" />
        <SolidColorBrush x:Key="LineBrush" Color="#262B35" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8A93A6" />
        <SolidColorBrush x:Key="GoodBrush" Color="#7ED08A" />
        <SolidColorBrush x:Key="WarnBrush" Color="#E8B15C" />
        <SolidColorBrush x:Key="LabelBrush" Color="#C8CFDC" />

        <!-- 总池：极致简化的一行 -->
        <DataTemplate x:Key="TotalRowTemplate">
            <Grid Height="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding State}" Width="92" FontSize="10" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource LabelBrush}" />
                <TextBlock Grid.Column="2" Text="{Binding Stars}" FontSize="11" Margin="8,0" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" />
                <TextBlock Grid.Column="3" Text="{Binding Subtitle}" FontSize="10" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
            </Grid>
        </DataTemplate>

        <!-- 候选池 / 推荐池：简化卡片，只留基本信息 + 推荐理由 -->
        <DataTemplate x:Key="CandidateCardTemplate">
            <Border BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6"
                    Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource LabelBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding Stars}" FontSize="11" Foreground="{StaticResource GoodBrush}" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="8,0,0,0"
                                   Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="{Binding Tags}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding Reason}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource WarnBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Text="池子调试" FontSize="13" FontWeight="SemiBold"
                   Foreground="{StaticResource LabelBrush}" TextWrapping="Wrap" />

        <DockPanel Grid.Row="1" Margin="0,8,0,8" LastChildFill="False">
            <Button x:Name="RefreshButton" Content="刷新 (F5)" Padding="10,3" FontSize="11" Click="RefreshButton_Click" />
            <CheckBox x:Name="AutoRefreshCheck" Content="自动刷新（2 秒）" FontSize="11" Margin="10,0,0,0"
                      VerticalAlignment="Center" Checked="AutoRefreshCheck_Changed" Unchecked="AutoRefreshCheck_Changed" />
            <TextBlock x:Name="HintText" Text="" FontSize="10" Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" />
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel>
                <TextBlock x:Name="TotalHeader" DockPanel.Dock="Top" Text="总池" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" Margin="2,0,0,4" />
                <ListBox x:Name="TotalList" Background="Transparent" BorderThickness="0"
                         ItemTemplate="{StaticResource TotalRowTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
            </DockPanel>

            <DockPanel Grid.Column="2">
                <TextBlock x:Name="CandidateHeader" DockPanel.Dock="Top" Text="候选池" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" Margin="2,0,0,4" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="CandidateList" ItemTemplate="{StaticResource CandidateCardTemplate}" />
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="FooterText" Text="" FontSize="10" Margin="2,8,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource MutedBrush}" />
    </Grid>
</Window>
